# Public application URL. Use your deployed HTTPS URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-only. Never expose this value to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reserved for authenticated Vercel cron routes in a later phase.
CRON_SECRET=replace-with-a-long-random-value

# Optional development seed input. Must reference an existing auth.users UUID.
SEED_ENVIRONMENT=development
SEED_USER_ID=
